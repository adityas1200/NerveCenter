# Tracked defaults for NerveCenter builds and images.
#
# Only ServiceNow creds go to AWS Secrets Manager (beacon/<env>/nervecenter).
# DB creds + anthropic_api_key are shared via beacon/<env>/common, matching
# ai_for_data / ai4dm exactly.
#
# Load rule (see deploy/aws/ec2/deploy-component.sh — either-or, NOT layered):
#   * host deploy/aws/.env exists (sandbox / prod EC2)  -> this file is IGNORED
#   * host deploy/aws/.env absent   (dev)               -> this file is loaded
# So dev-only values (SSO URL, DB schema, JWT/SECRET) below cannot leak into
# sandbox — sandbox reads its host deploy/aws/.env exclusively and this file is
# never touched. Real env vars from SSM RunCommand + AWS Secrets Manager
# hydration (runtime-env.mjs) still run on top on every env.

# Ops storage backends. Connector/connection credentials are encrypted (AES-256-GCM) into the
# ops_secrets table in NC_DB_SCHEMA with OPS_SECRET_ENCRYPTION_KEY, so the pod needs no
# Secrets Manager write access. Changing the key makes stored credentials unreadable; re-save
# the connectors after a rotation.
OPS_SECRET_STORE=postgres
OPS_SECRET_ENCRYPTION_KEY=a901da316db4a67b46ca92c0d0ded9fa415a1b71abd772d7fc281678163a1095
OPS_METADATA_STORE=postgres

# Ports
FRONTEND_PORT=8420
BACKEND_PORT=8421

# Env identity placeholders — overridden by --env at deploy time or host .env.
APP_ENV=prod
BEACON_ENV=prod

# AWS Secrets Manager hydration (sandbox host .env overrides to false).
USE_AWS_SECRETS=false
AWS_REGION=us-east-1
AWS_SECRET_PREFIX=beacon
AWS_SECRET_GROUPS=nervecenter,common
# Where the app stores connector and connection credentials (<prefix>/connectors/<id>/<KEY>).
# Without it the store falls back to AWS_SECRET_PREFIX and asks for beacon/connectors/*, which the
# dev role can't read. Trying the path the shared role already reads; move it if IAM denies this.
NC_SECRET_PREFIX=beacon/prod/common

# Dev shares Postgres + S3 bucket with siblings — isolation by schema + prefix.
# Sandbox overrides NC_DB_SCHEMA to blank in host deploy/aws/.env (dedicated DB).
NC_DB_SCHEMA=nervecenter
OPS_S3_PREFIX=nervecenter

# ServiceNow creds come from beacon/<env>/nervecenter in Secrets Manager; connections are
# otherwise configured in the app (Connectors) and stored in the workspace, which is mirrored
# to s3://<s3_bucket>/<OPS_S3_PREFIX>/workspace/ (see deploy/README.md).
OPS_WORKSPACE_SYNC_SECONDS=60
OPS_MAX_CONCURRENT_TASKS=3
OPS_TICKET_POLL_SECONDS=120
OPS_INTEGRATION_SYNC=1
OPS_INTEGRATION_SYNC_SECONDS=60
OPS_KNOWLEDGE_SYNC_SECONDS=900
OPS_GITHUB_SYNC_SECONDS=300
OPS_SYNC_IDLE_SECONDS=90

OPS_ADMIN_USER_IDS=29756537-275d-429b-9b3e-bd64c3704aee,nagajaswanth.ganta@zs.com

# Shared secret nginx sends as X-Ops-Trusted-Identity so the backend trusts its identity headers.
# Dev's k8s Deployment doesn't set it, and both images fill it from this file, so they match.
# Sandbox/prod hosts set their own in deploy/aws/.env, which ignores this file.
OPS_TRUSTED_IDENTITY_TOKEN=924dc7dd3625e2bf4d9b91fdb61efb51aeddd081d65aa58e4081f032fd94e02b

# SSO endpoint for dev. Sandbox overrides to blank via host deploy/aws/.env
# (config.mjs then falls back to the built-in sandbox URL).
OPS_SSO_SESSION_URL=https://agenticdm.dev.zsservices.com/apps/api/v1/auth/session
# Dev validates each user's SSO cookie against the URL above, as compose does by default. Without
# this, production falls back to trusted-gateway, which requires nginx's header on every request.
OPS_IDENTITY_MODE=central-sso
OPS_CORS_ORIGIN=https://agenticdm.dev.zsservices.com

VITE_AUTH_API_BASE_URL=/apps/api/v1

# Where dev serves NerveCenter: its own EKS pod at /nervecenter, not /apps/nervecenter like the
# dataverse apps. The build embeds the VITE_ pair; the frontend container's nginx reads
# PUBLIC_BASE_PATH at start. All three must match the ingress path.
PUBLIC_BASE_PATH=/nervecenter
VITE_APP_BASE=/nervecenter
VITE_API_BASE_URL=/nervecenter
# Page Refresh countdown, in seconds. 0 disables; rebuild frontend after changing.
VITE_AUTO_REFRESH_SECONDS=300

# Where the frontend container's nginx proxies /api and /health on dev: the API's k8s Service
# (same namespace). Compose sets its own backend:8787.
BACKEND_UPSTREAM=aws-k8s-a0394-d-svc-shrd-dmb-nervecenter-api:8787

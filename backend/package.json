{
  "name": "nervecenter-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "NerveCenter backend: operations data, tasks over the operations-fleet plugin, routines.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/main.mjs",
    "dev": "tsx watch src/main.mts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "verify:build": "npm run typecheck && npm run build && node --import ./tests/test-environment.mjs --test tests/build-output.check.mjs",
    "test": "node --import tsx --import ./tests/test-environment.mjs --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "pg": "^8.16.0",
    "snowflake-sdk": "^3.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

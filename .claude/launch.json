        "--env-file=../.claude/review-frontend.env",
        "./node_modules/vite/bin/vite.js",
        "--port",
        "5186",
        "--strictPort"
      ],
      "cwd": "frontend",
      "port": 5186
    },
    {
      "name": "frontend-iso",
      "runtimeExecutable": "node",

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "backend",
      "port": 8787
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5175
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8099"
      ],
      "cwd": "docs/mockup-v2",
      "port": 8099
    },
    {
      "name": "mockup-home",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8098"
      ],
      "cwd": "docs/mockup-home",
      "port": 8098
    },
    {
      "name": "mockup-task",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8097"
      ],
      "cwd": "docs/mockup-task",
      "port": 8097
    },
    {
      "name": "backend-verify",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=../.claude/verify-backend.env",
        "src/main.mjs"
      ],
      "cwd": "backend",
      "port": 8797
    },
    {
      "name": "frontend-verify",
